DEMO_MODE=true
# Session keys are random opaque tokens stored hashed in the local SQLite database.
# npm run dev:ai enables local model inference without sending sources to a cloud provider.
LECTURE_AI_PROVIDER=disabled
LECTURE_OLLAMA_URL=http://127.0.0.1:11434
LECTURE_LLM_MODEL=qwen2.5:3b
LECTURE_EMBEDDING_MODEL=bge-m3
LECTURE_ASR_BACKEND=mlx
LECTURE_ASR_MODEL=mlx-community/whisper-small-mlx
# Optional: LECTURE_ASR_LANGUAGE=vi (leave unset for automatic language detection)
LECTURE_UPLOAD_LIMIT_MB=256
# Set LECTURE_ASR_BACKEND=whisper on Linux/Windows after installing requirements-ai.txt.
# Optional: LECTURE_CLASSIFIER_PATH=/absolute/path/question-classifier.json
# Optional: LECTURE_DB=/absolute/path/lecturetwin.db
# Optional: LECTURE_DATA_DIR=/absolute/path/data
